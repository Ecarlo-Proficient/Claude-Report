# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — secrets + config for the Synology Docker test (Phase 1).
#
# Copy this to .env.docker and fill in real values. chmod 600 on the host.
# NEVER commit the populated file to git. .gitignore covers .env.docker already.
#
# Two categories:
#   1. Secrets — Notion + QBO tokens. Live values in Ted's macOS Keychain today.
#   2. Notion data source IDs — non-secret UUIDs from the DB URLs.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Secrets ────────────────────────────────────────────────────────────────
# Notion integration token (starts with `secret_` or `ntn_`)
NOTION_SECRET=

# QuickBooks Online OAuth credentials.
# Initial values come from the app's developer dashboard + first OAuth flow.
# The container persists rotated refresh tokens to /data/qbo_secrets.json
# (named volume) so restarts keep working through Intuit's token rotations.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_COMPANY_ID=
QBO_REFRESH_TOKEN=

# ─── Notion data source IDs (non-secret UUIDs) ──────────────────────────────
# Invoice Tracker
INVOICE_RES_COM_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
INVOICE_MFD_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CUSTOMER_LIST_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MFD_CLIENT_LIST_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
INVOICE_PAID_RETENTION_MONTHS=12

# WIP Tracker (kept for parity with .env, even if not running in Phase 1)
WIP_MFD_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WIP_RPCP_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WIP_SNAPSHOTS_MFD_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WIP_SNAPSHOTS_RPCP_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WIP_LOOKBACK_MONTHS=24
WIP_MIN_ACTIVITY_USD=5000

# ─── Teams notifications (MFD only, Phase 1) ───────────────────────────────
# Microsoft Teams "Workflows" webhook URL for MFD paid + short-pay events.
# Setup in Teams: channel → ⋯ → Workflows → "Post to a channel when a webhook
# request is received". Paste the resulting logic.azure.com URL here.
# NOTE: this URL is a POSTING CREDENTIAL — treat the real .env.docker like a
# secrets file (chmod 600, never commit). On Mac it lives in Keychain instead.
# Leave EMPTY to disable Teams notifications.
TEAMS_WEBHOOK_MFD_PAID=

# ─── Teams OPS-ALERT webhook (v1) ───────────────────────────────────────────
# Separate Workflows webhook for SYNC FAILURE / ERROR warnings. Because the
# container runs unattended, this is how you find out a run crashed or finished
# with errors. The alert names the runtime ("v1.0.0 (docker)" vs "mv1 (mac)")
# so you know which instance fired it while both run during testing.
# Same setup as above (channel → ⋯ → Workflows). Posting credential — keep secret.
# Leave EMPTY to disable alerts.
TEAMS_WEBHOOK_ALERTS=

# ─── Behavior ───────────────────────────────────────────────────────────────
OVERLAP_SECONDS=30
INITIAL_LOOKBACK=2026-04-01T00:00:00Z

# Excel mirror: OFF in the container for v1 (baked SKIP_EXCEL_EXPORT=1 in the
# image — the Mac still owns the Excel mirror during coexistence testing).
# To move Excel into the container later, set SKIP_EXCEL_EXPORT= (empty) here
# once the OneDrive bridge (Cloud Sync → /data/onedrive) is validated.
# SKIP_EXCEL_EXPORT=
# INVOICE_EXPORT_PATH=/data/onedrive/Open_Invoices.xlsx

# State dir (sync + CDC watermarks). Defaults to /data/state in the image so it
# persists on the named volume; override only if you mount state elsewhere.
# STATE_DIR=/data/state

# Sync cadence — every 15 min. Override for testing if needed.
SYNC_INTERVAL_SECONDS=900
