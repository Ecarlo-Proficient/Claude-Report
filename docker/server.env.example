# server.env - the office server's paths and ids. NO secrets here (those are keys/secrets.env).
# Copy to /volume1/docker/automation/server.env on the Synology. Paths are the CONTAINER's (right side of compose.yml).

# test = the side-by-side week (writes only TEST_DIR, Notion untouched); live = the server writes, if the writer file says so
ACB_SERVER_MODE=test
ACB_HOST_NAME=office-server
MIRROR_EVERY_SECONDS=180
APAR_EVERY_SECONDS=900
RECONCILE_AT=02:30
MIRROR_STALE_MINUTES=30
ALERT_QUIET_MINUTES=60

# what the scheduler writes
STATUS_DIR=/data/status
LOG_DIR=/data/logs
STATE_DIR=/data/state
SHARE_STATUS_FILE=/mnt/accounting/_automation/server-status.json
WRITER_FILE=/mnt/accounting/_automation/writer.json
TEST_DIR=/mnt/accounting/_server-test

# the files (Accounting share = the Synology itself)
ACB_ACCOUNTING_BASE=/mnt/accounting
ACB_BILL_TRACKER_XLSX=/mnt/accounting/Accounts Payable/Bill Tracker.xlsx
INVOICE_EXPORT_PATH=/mnt/accounting/Accounts Receivable/Invoice Tracker.xlsx
LIVE_BILL_TRACKER_XLSX=/mnt/accounting/Accounts Payable/Bill Tracker.xlsx
LIVE_INVOICE_TRACKER_XLSX=/mnt/accounting/Accounts Receivable/Invoice Tracker.xlsx
ACB_GENERAL_LIST_XLSX=/mnt/general-list/LISTA GENERAL AÑO 2026.xlsx
ACB_PO_TRACKER_XLSX=/mnt/po-tracker/1.0purchase-order-tracker.xlsx
ACB_COMPANYHEALTH_DIR=/data/companyhealth
ACB_QBO_MIRROR_DB=/data/mirror/qbo_mirror.sqlite3
QBO_SECRETS_FILE=/data/keys/qbo_secrets.json

# Notion ids (not secrets) - copy the values from the owner's Mac: invoice-sync/.env
INVOICE_RES_COM_DS_ID=
INVOICE_MFD_DS_ID=
CUSTOMER_LIST_DS_ID=
MFD_CLIENT_LIST_DS_ID=
LIEN_TRACKER_DS_ID=
