# .dockerignore — exclusions for `docker build` context (project root).
# Smaller context = faster builds + smaller images. Anything not on this list
# gets shipped INTO the build context, so be explicit.

# Local-only / unrelated workers
bill-tracker/
debt-schedule/
health-dashboard/
wip/
docs/
.obsidian/

# Virtual environments — the image installs its own deps from requirements.txt;
# never ship a host-built (esp. macOS) venv into the Linux container.
**/venv/
**/.venv/

# Build artifacts / caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# State / runtime — must NEVER be baked into an image
invoice-sync/logs/
invoice-sync/state/
invoice-sync/.env
invoice-sync/.env.secrets
# pre-2026-07 layout leftovers (untracked files linger after the rename)
automation-worker/
Open_Invoices*.xlsx

# Secrets
**/.env
**/.env.docker
**/.env.secrets

# Docs / outputs / scratch
*.md
!docker/README.md
*.docx
*.xlsx
*.pdf
*.pptx

# IDE / OS noise
.DS_Store
.idea/
.vscode/
*.swp
