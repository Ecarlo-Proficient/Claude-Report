# .dockerignore - the build context is the repo root, but ONLY the allow-list gets in.
# Everything is excluded, then the image's files are let back in by name.
*
!python-env/requirements.lock
!shared/
!bill-tracker/
!invoice-sync/
!ledger/refresh_mirror.py
!docker/scheduler.py
# never ship local config, state, logs or caches from a clone
**/.env
**/.env.*
**/state/
**/logs/
**/__pycache__/
**/*.pyc
**/.DS_Store
