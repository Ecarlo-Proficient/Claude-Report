# secrets.env - the office server's keys. Lives ONLY in /volume1/automation-keys/ (an ENCRYPTED shared folder),
# mode 600, owned by the automation user. Never in git, chat or email. Every value is typed in on the Synology.

# QuickBooks: the SERVER's OWN Intuit app ("Office Server") - never the owner's app, never the developer's app
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_COMPANY_ID=
# first refresh token only; renewed tokens are saved to /data/keys/qbo_secrets.json from then on
QBO_REFRESH_TOKEN=

# the server's own mirror key: 32 random bytes, base64 (generate on the Synology - see README step 5)
MIRROR_KEY=

# Notion integration token + Teams webhooks (the owner provides these)
NOTION_SECRET=
TEAMS_WEBHOOK_MFD_PAID=
TEAMS_WEBHOOK_ALERTS=
