<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.proficient.invoice-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sebas/Documents/Claude/Projects/Automate Concrete Business/invoice-sync/run_invoice_sync.sh</string>
    </array>

    <!-- Every 15 minutes (900 seconds) -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Don't run multiple instances if a previous run is still going. -->
    <key>AbandonProcessGroup</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/sebas/Library/Logs/Proficient/automation-worker/invoice_sync.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sebas/Library/Logs/Proficient/automation-worker/invoice_sync.launchd.err</string>
</dict>
</plist>
