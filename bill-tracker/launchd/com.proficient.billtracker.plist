<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.proficient.billtracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sebas/Documents/Claude/Projects/Automate Concrete Business/bill-tracker/run_tracker.sh</string>
    </array>

    <!-- Mon-Fri at 15:00 (3 PM) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <!-- Send stdout / stderr to dedicated launchd log files -->
    <key>StandardOutPath</key>
    <string>/Users/sebas/Library/Logs/Proficient/bill-tracker/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/sebas/Library/Logs/Proficient/bill-tracker/launchd_stderr.log</string>

    <!-- Run only when the user is logged in (Touch ID / Keychain require an interactive session) -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
