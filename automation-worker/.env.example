# Proficient Automation Worker — NON-SECRET config only
# Copy to .env. This file holds config, not secrets.
#
# SECRETS live in the OS keystore:
#   - Mac: macOS Keychain (run `python setup_keychain.py` once)
#   - Pi:  environment var NOTION_SECRET loaded from a chmod-600 .env.secrets
#          (kept on the Pi only, never synced from Mac)

# ---- Invoice Tracker (QBO → Notion) data source IDs (UUIDs from the DB URL — not secret) ----
# Invoice Tracker (Res/Com) — RP + CP invoices, with Division select.
INVOICE_RES_COM_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Invoice Tracker (MFD) — MFD-only, isolated DB.
INVOICE_MFD_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Customer relation targets (the customer DBs the Customer relation points to).
CUSTOMER_LIST_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MFD_CLIENT_LIST_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# How long to keep paid invoices in Notion before archiving (months).
# Anything older is soft-deleted on the next sync. Open invoices stay forever.
INVOICE_PAID_RETENTION_MONTHS=12

# ---- Behavior ----
# How far back to overlap the query window (seconds). Upsert is idempotent,
# so re-processing the overlap is harmless and guards against missed edits.
OVERLAP_SECONDS=30

# Initial lookback (ISO 8601) — used on very first run when no state exists.
# Set this to roughly when you backfilled, or earlier to process everything.
INITIAL_LOOKBACK=2026-04-01T00:00:00Z

# ---- Keychain / keystore identifiers (not secret, just lookup keys) ----
# Service name used in Keychain / libsecret. Don't change unless you know why.
KEYSTORE_SERVICE=proficient-automation-worker
# Key names — one per external service. Script looks up secrets by these names.
KEYSTORE_KEY_NOTION=notion
KEYSTORE_KEY_TEAMS_WEBHOOK=teams_webhook_mfd_paid
# KEYSTORE_KEY_QBO=qbo
# KEYSTORE_KEY_MS_GRAPH=ms-graph

# ---- Teams MFD paid/short-pay webhook ----
# This URL is a POSTING CREDENTIAL (anyone holding it can post to the channel),
# so on Mac it lives in Keychain, NOT here:
#     python setup_keychain.py --teams             (paste it)
#     python setup_keychain.py --teams --from-env  (migrate an existing .env value)
# On Linux/Docker only (no Keychain), set it as an env var instead:
# TEAMS_WEBHOOK_MFD_PAID=
# Leave unset to disable Teams notifications.
